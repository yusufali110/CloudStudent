# Backend Environment Variables Template
PORT=5000
NODE_ENV=development
# Local connection string example:
MONGODB_URI=mongodb://localhost:27017/cloudstudent
# Docker Compose connection string example:
# MONGODB_URI=mongodb://admin:secret123@mongodb:27017/cloudstudent?authSource=admin
# Kubernetes connection string example:
# MONGODB_URI=mongodb://cloudstudent_user:password123@mongo-headless:27017/cloudstudent?authSource=cloudstudent
